<?xml version="1.0" encoding="utf-8"?>
<resources>
  <!-- Android 12+ system splash: dark backdrop with the animated Omnitrix constellation.
       Overrides the base Theme.Rikkahub (values/themes.xml) only to add splash attrs. -->
  <style name="Theme.Rikkahub" parent="Theme.Material3.DayNight.NoActionBar">
    <item name="android:windowSplashScreenBackground">#0B0F0C</item>
    <item name="android:windowSplashScreenAnimatedIcon">@drawable/omnitrix_splash_animated</item>
    <item name="android:windowSplashScreenAnimationDuration">1600</item>
  </style>
</resources>
